APP_ENV=development
DATABASE_URL=sqlite:///./duxue_appointment.db
JWT_SECRET=请替换为至少32字节的随机密钥
ACCESS_TOKEN_MINUTES=720

# 值班电脑：与 Web 值班工位 localStorage 中保存的值一致
DUTY_TERMINAL_TOKEN=请替换为随机终端Token
DUTY_TERMINAL_IPS=

# AI 审核（OpenAI-compatible JSON API）
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# OCR，可留空转人工核验
OCR_API_URL=
OCR_API_KEY=
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# 本地首次启动可选管理员白名单
BOOTSTRAP_ADMIN_ID=
BOOTSTRAP_ADMIN_NAME=系统管理员
BOOTSTRAP_ADMIN_PASSWORD=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
