.login-page { min-height: 100vh; box-sizing: border-box; padding: 110rpx 42rpx 48rpx; background: linear-gradient(180deg, #eef5ff 0%, #f6f8fb 42%, #f6f8fb 100%); }
.brand { display: flex; flex-direction: column; align-items: center; margin-bottom: 58rpx; }
.brand-mark { width: 108rpx; height: 108rpx; border-radius: 32rpx; display: flex; align-items: center; justify-content: center; background: #1f6feb; color: #fff; font-size: 54rpx; font-weight: 800; box-shadow: 0 18rpx 44rpx rgba(31,111,235,.24); }
.brand-title { margin-top: 26rpx; font-size: 46rpx; font-weight: 800; letter-spacing: 4rpx; }
.brand-subtitle { margin-top: 10rpx; color: #667085; font-size: 26rpx; }
.login-card { background: #fff; border-radius: 32rpx; padding: 38rpx 32rpx 34rpx; box-shadow: 0 16rpx 50rpx rgba(31, 54, 85, .08); }
.card-title { font-size: 36rpx; font-weight: 800; }
.card-note { margin-top: 12rpx; color: #7a8699; font-size: 25rpx; line-height: 1.6; }
.field { margin-top: 30rpx; }
.label { margin-bottom: 12rpx; color: #344054; font-size: 26rpx; font-weight: 600; }
.login-button { margin-top: 36rpx; }
.security-note { margin-top: 30rpx; text-align: center; color: #98a2b3; font-size: 22rpx; }

.error-banner { margin-top:20rpx; padding:18rpx 20rpx; border-radius:16rpx; background:#fff0f0; color:#c93636; font-size:24rpx; line-height:1.5; }
